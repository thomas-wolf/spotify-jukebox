[Unit]
Description=go-librespot (Spotify Connect receiver)
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
SupplementaryGroups=audio
# Adjust the binary path (the name is in the unpacked release archive)
ExecStart=/usr/local/bin/go-librespot -config_dir /home/pi/.config/go-librespot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=go-librespot (Spotify-Connect-Empfaenger)
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
SupplementaryGroups=audio
# Pfad zum Binary anpassen (Name steht im entpackten Release-Archiv)
ExecStart=/usr/local/bin/go-librespot -config_dir /home/pi/.config/go-librespot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

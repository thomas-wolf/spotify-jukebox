[Unit]
Description=Spotify jukebox
# Deliberately no network-online.target: display, buttons and sounds do not need the network and should be up
# seconds earlier. go-librespot waits for the network on its own; until it answers, Spotify cards report an error.
After=sound.target
Wants=go-librespot.service

[Service]
Type=simple
User=pi
SupplementaryGroups=audio gpio i2c spi dialout input
ExecStart=/opt/jukebox/venv/bin/jukebox -c /home/pi/.config/jukebox/config.toml run
Restart=on-failure
RestartSec=3
# Needs permission to power off; allow it with a polkit rule or sudoers entry
# for `systemctl poweroff` if shutdown cards/buttons should work.

[Install]
WantedBy=multi-user.target
